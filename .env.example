# Copy to .env and fill in. Every value below is optional except the first two.
# Run `npm run login` and the TG_* credentials are written back here for you.

# --- Telegram API credentials (required) -------------------------------------
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# --- Session -----------------------------------------------------------------
# Where the StringSession is stored. THIS FILE IS YOUR ACCOUNT - keep it secret.
# TG_SESSION_FILE=./session.txt
# TG_SESSION=1BVtsOK...        # inline session string instead of a file (advanced)
# ENV_FILE=.env                # which file this loader reads

# --- Behaviour ---------------------------------------------------------------
# Chat titles to ignore in watch output (comma-separated)
EXCLUDE=
# How your own messages are labelled in output (default: ME)
SELF_NAME=
# Display timezone for message timestamps (default: the system timezone)
# TZ_NAME=Europe/Athens

# --- MCP server --------------------------------------------------------------
# Port for the streamable-HTTP transport. Leave empty to use stdio instead.
MCP_HTTP_PORT=8790
# Interface to bind. Use 127.0.0.1 unless a container/network must reach it
# (the Docker compose file sets 0.0.0.0 for you).
MCP_HOST=127.0.0.1
# Bearer token required on /mcp. STRONGLY recommended whenever MCP_HTTP_PORT is
# set - without it anyone who can reach the port can read and send as you.
MCP_TOKEN=
# If set, tg_send_message only accepts these chat titles (comma-separated).
SEND_ALLOWLIST=

# --- Reaction marker ---------------------------------------------------------
# Reacting to any message with this emoji forwards it to NOTIFY_CHAT.
REACTION_EMOJI=✍️
# Where marker notifications go. "me" = your own Saved Messages.
NOTIFY_CHAT=me
# Optional regex: only marker reactions on matching message text are forwarded.
MARKER_FILTER=
# Notification body. Placeholders: {chat} {sender} {text} {msgId}
# MARKER_MESSAGE="Marker\nChat: {chat}\nFrom: {sender}\nText: \"{text}\"\n(msgId={msgId})"
# Set to 1 to attach the marker listener inside the MCP process (one session
# per process - do not also run `npm run reactions` against the same session).
START_LISTENER=
# Where already-processed markers are remembered (dedup across restarts).
# SEEN_FILE=./tg-marker-seen.json

# --- QR login ----------------------------------------------------------------
# QR_PORT=8791
# QR_BIND=127.0.0.1
# TG_2FA=                      # two-step password, if you have one
